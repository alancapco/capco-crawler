# Firecrawl key for crawl_capco.py / start.py (required to crawl, not for the graph stack).
FIRECRAWL_API_KEY=fc-replace-me

# OpenAI-compatible chat model used to build the knowledge graph.
# Copy this file to .env and fill in the three LLM values.
# The UI model id is fixed as "capco_compatible". Change the model name here, then restart the backend.
# Values cannot contain commas. llm-graph-builder stores them as model,base_url,api_key.
# The backend runs on this machine, so a local server (LM Studio, vLLM, Ollama's OpenAI port) is localhost.
# Include the /v1 prefix when the provider expects the OpenAI path layout.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=your-model-name
# Chunks sent to the LLM at once per article. Keep below the provider's concurrent-request cap.
LLM_MAX_CONCURRENCY=2
LLM_MAX_RETRIES=8

# Local sentence-transformers embedding model, loaded offline by the backend.
# Point EMBEDDING_MODEL_DIR at a Hugging Face cache repo (models--org--name) or a plain model folder.
# On a new VM, copy the model directory or download it, then set this path.
# EMBEDDING_DIMENSION must match the model. Changing models later requires dropping the
# Neo4j vector index (or the neo4j_data volume), because the stored vectors keep the old size.
EMBEDDING_MODEL_DIR=/path/to/models--BAAI--bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Local Neo4j created by docker compose. The password is applied only on the first start
# of an empty neo4j_data volume. To change it later, wipe that volume and restore/re-ingest.
NEO4J_PASSWORD=capco-graph-change-me
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# Optional Neo4j memory (passed through docker-compose.yml). Defaults shown.
# NEO4J_HEAP_INITIAL=512m
# NEO4J_HEAP_MAX=1G
# NEO4J_PAGECACHE=512m

# Bolt address the ingest script sends to the backend. Neo4j publishes 7687 on this machine.
NEO4J_URI=bolt://localhost:7687

# Graph builder API as seen from this machine.
GRAPH_API_URL=http://localhost:8000

# Extraction tuning for ingest_graph.py
GRAPH_TOKEN_CHUNK_SIZE=500
GRAPH_CHUNK_OVERLAP=20
GRAPH_CHUNKS_TO_COMBINE=1
GRAPH_EXTRACT_TIMEOUT=3600
GRAPH_ADDITIONAL_INSTRUCTIONS=Extract organizations, regulations, products, markets, and the relationships described in this Capco research article.
